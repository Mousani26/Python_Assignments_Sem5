''' 
Write a Python program to perform a Chi-Square Test of Independence to examine whether two categorical variables are associated or independent. 
'''


from scipy import stats

# Observed data (contingency table)
data = [[20, 30],
        [40, 10]]

# Perform Chi-Square Test
ch, p, dof, ef = stats.chi2_contingency(data)

# Display results
print("Chi-Square Value:", ch)
print("P-value:", p)
print("Degrees of Freedom:", dof)
print("Expected Frequencies:\n", ef)

# Hypothesis testing
if p < 0.05:
    print("Reject the Null Hypothesis")
else:
    print("Fail to Reject the Null Hypothesis")
