'''
Write a Python program using the Pandas library to create a Series containing the marks of 5 students.
First, create a Series with default indexing and then create another Series using the students' names as custom indexes.
'''


import pandas as pd

# Create a series of marks
marks = pd.Series([12, 13, 14, 15, 16])

print("Marks of 5 Students:")
print(marks)

# Create a series with student names as index
marks = pd.Series([12, 13, 14, 15, 16],
                  index=['Rita', 'Arup', 'Sanju', 'Disha', 'Sonia'])

print("\nMarks with Student Names:")
print(marks)
