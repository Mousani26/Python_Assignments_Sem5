'''
Write a Python program using the Pandas library to create a DataFrame using a Dictionary for 5 employees with the following attributes:
emp_id, emp_name, dept, and salary.
'''

import pandas as pd

# Create a dictionary of 5 employees
data = {
    'emp_id': [101, 102, 103, 104, 105],
    'emp_name': ['Rita', 'Arup', 'Sanju', 'Disha', 'Sonia'],
    'dept': ['HR', 'IT', 'Finance', 'Sales', 'IT'],
    'salary': [30000, 45000, 35000, 40000, 50000]
}

# Create DataFrame
df = pd.DataFrame(data)

# Display DataFrame
print("Employee DataFrame:")
print(df)
